# cad-etf-holdings environment. Copy this file to .env and edit it; .env is
# never committed. Every variable the code reads is listed here.

# --- Collection --------------------------------------------------------------
# Identifies this project to issuers and provides a contact address. Required
# for live collection; the value must contain a contact e-mail or URL. Quoted
# because the example contains spaces and parentheses.
ETFH_USER_AGENT="cad-etf-holdings/0.1 (you@example.com)"

# Optional. Raises the OpenFIGI rate limits when set; the API works without a
# key. `etfh build --openfigi` is the only caller.
OPENFIGI_API_KEY=

# Set to 1 to make ops/run_collect.sh pass --openfigi to `etfh build` on the
# scheduled run. Off by default.
ETFH_OPENFIGI=0

# --- Paths and configuration -------------------------------------------------
# Directory holding sources.yaml, funds.csv, security_overrides.csv and
# validation.yaml. Defaults to ./config.
ETFH_CONFIG_DIR=config

# DuckDB file the dashboard opens. Defaults to ./build/etfh.duckdb.
ETFH_DB=./build/etfh.duckdb

# --- Runtime -----------------------------------------------------------------
# Thread limit for DuckDB connections opened by the package (one low-priority
# CI runner sets 1). Unset means DuckDB's own default.
ETFH_DUCKDB_THREADS=1

# Set to 1 to run the dashboard on a synthetic store instead of live data, for
# the public demo. Off by default.
ETFH_DEMO=0
