# Identifies this project and provides a contact address; required for collection.
# Must include a contact e-mail or URL, e.g. "cad-etf-holdings/0.1 (https://github.com/broiisapro/cad-etf-holdings)"
ETFH_USER_AGENT=

# Optional. Raises OpenFIGI rate limits when set; the API works without a key.
OPENFIGI_API_KEY=
