<?xml version="1.0" encoding="UTF-8"?>
<!--
  Daily local collection schedule for cad-etf-holdings.

  This file is a template: __REPO__ is the absolute path of the repository
  checkout and __HOME__ is the installing user's home directory. Run
  ops/install_launchd.sh to substitute both placeholders, write the result to
  ~/Library/LaunchAgents/com.etfh.collect.plist and print the launchctl
  bootstrap command. The job runs ops/run_collect.sh every day at 19:15
  local time; its stdout and stderr go to ~/Library/Logs/etfh/.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.etfh.collect</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>__REPO__/ops/run_collect.sh</string>
    </array>
    <key>WorkingDirectory</key>
    <string>__REPO__</string>
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>19</integer>
        <key>Minute</key>
        <integer>15</integer>
    </dict>
    <key>StandardOutPath</key>
    <string>__HOME__/Library/Logs/etfh/collect.log</string>
    <key>StandardErrorPath</key>
    <string>__HOME__/Library/Logs/etfh/collect.err.log</string>
    <key>RunAtLoad</key>
    <false/>
</dict>
</plist>
